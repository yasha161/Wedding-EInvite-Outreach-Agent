# ==============================================================================
# AI Outreach Engines - Environment Configuration
# ==============================================================================

# Sender Information
SENDER_NAME=Your Name
GMAIL_USER=your_email@gmail.com
# Google App Password (Generate from Google Account -> Security -> 2-Step Verification -> App Passwords)
GMAIL_APP_PASSWORD=your_16_char_app_password

# Telegram Bot Integration (Instant Lead & Phone Number Alerts)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_USER_ID=your_telegram_chat_id_here

# Master Agent Switches
# 1. Wedding & E-Invitation Agent (wedding_agent.py)
EMAIL_OUTREACH_ENABLED=False

# 2. Simple Creative Service Pitch Agent (service_pitch_agent.py - Video Editing/Reels/Podcasts)
# Default is False (OFF/Standby). Set to True to enable.
SERVICE_PITCH_ENABLED=false

# Rate Limiting & Spacing (Seconds between email dispatches)
MIN_DELAY_SECONDS=45
MAX_DELAY_SECONDS=75

# Batch Limits (Per run)
DEFAULT_BATCH_MAX=15
