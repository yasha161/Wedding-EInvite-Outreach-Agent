# ==============================================================================
# Wedding & E-Invitation AI Outreach Agent - Environment Configuration
# ==============================================================================

# Sender Information
SENDER_NAME=Your Name
GMAIL_USER=your_email@gmail.com
# Google App Password (Generate from Google Account -> Security -> 2-Step Verification -> App Passwords)
GMAIL_APP_PASSWORD=your_16_char_app_password

# Telegram Bot Integration (Instant Lead & Phone Number Alerts)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_USER_ID=your_telegram_chat_id_here

# Outreach Safety Switch (Set to True only when ready to dispatch emails)
EMAIL_OUTREACH_ENABLED=False

# Rate Limiting & Spacing (Seconds between email dispatches)
MIN_DELAY_SECONDS=45
MAX_DELAY_SECONDS=75

# Batch Limits (Per morning/afternoon/night run)
DEFAULT_BATCH_MAX=15
